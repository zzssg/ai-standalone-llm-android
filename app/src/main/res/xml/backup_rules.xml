<?xml version="1.0" encoding="utf-8"?>
<!--
    Pre-Android-12 counterpart of data_extraction_rules.xml. Backup is already
    disabled via android:allowBackup="false"; this states the same intent for the
    legacy mechanism so the two cannot drift apart.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
