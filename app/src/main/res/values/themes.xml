<resources>
    <!--
        Launch theme only: everything after onCreate is drawn by Compose, which
        gets its colours from ui/theme/Theme.kt, not from here.

        The parent is a *platform* theme on purpose. Theme.Material3.* would pull
        in com.google.android.material, and Theme.AppCompat.* would pull in
        androidx.appcompat: two Views-era libraries this app otherwise has no
        use for. The day/night split is handled by values-night/ instead of a
        DayNight parent.

        The previous theme was Theme.AppCompat.Light.DarkActionBar, which drew a
        second title bar above the Compose UI and stayed light in dark mode.
    -->
    <style name="Theme.LlmChat" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
