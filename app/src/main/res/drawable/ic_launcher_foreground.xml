<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher foreground: a speech bubble with three cut-out dots.

    Drawn as a single path with evenOdd fill so the dots are genuine holes rather
    than shapes painted in the background colour. That matters for the themed
    (monochrome) icon on Android 13+, where the system recolours the whole
    drawable: holes stay holes, whereas a dot painted honey would vanish into the
    tint and leave a blank bubble.

    Everything sits inside the central 66dp safe zone, so no launcher mask can
    clip the shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#FFFDF6EC"
        android:fillType="evenOdd"
        android:pathData="
            M40,30
            H68
            A14,14 0 0 1 82,44
            V58
            A14,14 0 0 1 68,72
            H52
            L37,84
            L40,72
            A14,14 0 0 1 26,58
            V44
            A14,14 0 0 1 40,30
            Z
            M41,51 m-5.5,0 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0
            M54,51 m-5.5,0 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0
            M67,51 m-5.5,0 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0" />
</vector>
