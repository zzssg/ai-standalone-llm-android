<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher background: a deep warm ink, no gradient.

    The mark is flat, and the icon has to be the same object as the mascot on
    the first screen. The deep ground gives the light muzzle and brass lens a
    crisp silhouette at launcher size, instead of relying on low-contrast
    orange against cream.

    Lightened one step from #3F211A, and the handle in design/mascot.py was
    lightened with it: the handle is a mid brown, so moving this ground up
    towards it would otherwise have swallowed the one part of the mark that is
    drawn against the ground at all.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#FF4E2A20"
        android:pathData="M0,0h108v108h-108z" />
</vector>
