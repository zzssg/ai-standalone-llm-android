<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher background: the honey of the app's own primary colour, as a soft
    vertical gradient so the icon does not read as a flat swatch next to the
    rounded, shaded icons Android ships with.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt"
            name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFF0A030" />
                <item android:offset="1.0" android:color="#FFB26A00" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
