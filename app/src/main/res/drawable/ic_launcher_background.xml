<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher background: the lens colour, as a soft diagonal gradient.

    Deliberately the cool half of the palette rather than another orange. The
    mascot is fur-orange, and a warm background would leave it competing with
    its own field; teal is the complement, so the squirrel reads at the size a
    launcher actually shows it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt"
            name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF17A2BF" />
                <item android:offset="1.0" android:color="#FF0B5F74" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
