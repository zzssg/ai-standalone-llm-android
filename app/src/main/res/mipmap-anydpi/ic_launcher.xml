<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!--
        Themed icon for Android 13+. The system flattens this to one colour, and
        the coloured foreground flattens to a blob: the lens stops being a hole
        and the eye stops being an eye. This is the glass on its own, which is
        the part that still says what the app is without colour.
    -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
