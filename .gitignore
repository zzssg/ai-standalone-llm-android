.gradle/
build/

# NOTE: gradle/wrapper/ is deliberately NOT ignored. The old .gitignore excluded
# the whole gradle/ directory while committing gradlew, so a fresh clone had a
# launcher with no wrapper jar and `./gradlew assembleDebug` -- the command in
# the README -- failed immediately.
.vscode/
.idea/
*.iml

app/.cxx/
app/build/

# Model files are gigabytes; they are imported at runtime, never committed.
app/src/main/assets/models/
app/assets/models/
*.gguf

# Machine-specific SDK paths -- must never be committed.
local.properties

# Generated by generate_vulkan_shaders.*, not source.
vulkan-shaders-gen
vulkan-shaders-gen.exe

# Signing credentials and keystores must never be committed. Losing the keystore
# means never being able to update an already-installed build, so keep a backup
# somewhere outside the repo.
keystore.properties
*.jks
*.keystore

# Built APKs handed out for sideloading are artifacts, not source.
dist/
